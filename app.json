{
  "expo": {
    "name": "Kip",
    "slug": "BOB",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.maxschenck.bob",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.maxschenck.bob"
        ],
        "com.apple.developer.family-controls": true,
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "infoPlist": {
        "NSAlarmKitUsageDescription": "Kip rings a real alarm when you stay in a distracting app past your countdown."
      }
    },
    "android": {
      "package": "com.maxschenck.bob",
      "adaptiveIcon": {
        "backgroundColor": "#2B5A32",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CALENDAR"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#4CAF50",
          "defaultChannel": "bob-nudges"
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.maxschenck.bob.widgets",
          "groupIdentifier": "group.com.maxschenck.bob",
          "widgets": [
            {
              "name": "BobWidget",
              "displayName": "Kip",
              "description": "Kip, your streak and today's nudge.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryInline"
                ]
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Kip",
              "label": "Kip",
              "description": "Kip, your streak and today's nudge.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "previewImage": "./assets/bob-avatar.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "@bacons/apple-targets",
      "expo-asset",
      "expo-secure-store",
      [
        "expo-calendar",
        {
          "calendarPermission": "Kip reads your calendar to find exam dates and free time to study. Nothing is changed or uploaded."
        }
      ],
      "./plugins/withWorkManagerFix"
    ],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.maxschenck.bob.widgets",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.maxschenck.bob"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.maxschenck.bob.BobMonitor",
                  "targetName": "BobMonitor",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.maxschenck.bob"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "1a79153a-1e0b-4303-873b-0dd258008195"
      }
    },
    "owner": "maxschenck"
  }
}
